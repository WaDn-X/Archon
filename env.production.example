# Production Environment Configuration for Zippy-Archon
# Copy this file to .env.production and update with your production values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=production
RELEASE_VERSION=1.0.0
LOG_LEVEL=INFO

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
JWT_SECRET_KEY=your-very-secure-jwt-secret-key-here-change-this-in-production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT=30

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================
# At least one AI provider is required
XAI_API_KEY=your-xai-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ZIPPY_API_KEY=your-zippy-api-key

# =============================================================================
# EXTERNAL OLLAMA CONFIGURATION
# =============================================================================
# Connect to your existing Ollama instance (Docker Desktop + OpenWebUI on port 3000)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:7b

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Frontend Sentry (for React app)
VITE_SENTRY_DSN=https://your-frontend-sentry-dsn@sentry.io/project-id

# =============================================================================
# SERVICE PORTS (Following Zippy-Archon 827 pattern)
# =============================================================================
# See PORT_ASSIGNMENT_RULES.md for complete port assignment rules
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
ARCHON_UI_PORT=3737
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3827
NGINX_PORT=8280
NGINX_SSL_PORT=8443

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
MAX_WORKERS=4
WORKER_TIMEOUT=300

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
# Grafana admin password
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password

# =============================================================================
# BACKUP SETTINGS
# =============================================================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# =============================================================================
# SSL/TLS SETTINGS
# =============================================================================
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# =============================================================================
# EMAIL SETTINGS
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_MARKETPLACE=true
ENABLE_AB_TESTING=true
ENABLE_TRUST_VALIDATION=true
ENABLE_ANALYTICS=true


