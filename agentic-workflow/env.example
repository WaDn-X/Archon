# Zippy-Archon Platform Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT=30

# AI Provider API Keys
# Grok AI (xAI)
XAI_API_KEY=your_xai_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Zippy AI (custom)
ZIPPY_API_KEY=your_zippy_api_key_here
ZIPPY_API_URL=https://api.zippy.ai/v1

# Security and Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here_make_it_long_and_random
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://your-domain.com"]

# ZippyTrust Configuration
ZIPPYTRUST_ENABLED=true
ZIPPYTRUST_MIN_SCORE=0.6
ZIPPYTRUST_API_URL=https://api.zippytrust.com

# Marketplace Configuration
MARKETPLACE_ENABLED=true
ZIPPYCOIN_INITIAL_BALANCE=100.0
MARKETPLACE_FEE_PERCENTAGE=2.5

# A/B Testing Configuration
AB_TESTING_ENABLED=true
AB_TESTING_DEFAULT_RUNS=3
AB_TESTING_MAX_RUNS=10

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn_here
ENABLE_METRICS=true
METRICS_PORT=9090

# File Storage (optional)
STORAGE_TYPE=local  # or 's3', 'gcs'
STORAGE_BUCKET=zippy-archon-storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@zippy-archon.com

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Development Settings
ENVIRONMENT=development  # or 'production', 'staging'
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_SWAGGER_UI=true
ENABLE_RELOAD=true

# Feature Flags
FEATURE_MARKETPLACE=true
FEATURE_AB_TESTING=true
FEATURE_ZIPPYTRUST=true
FEATURE_MILESTONES=true
FEATURE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # seconds

# Backup and Recovery
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # cron format
BACKUP_RETENTION_DAYS=30
