{
  "name": "zippy-archon-orchestrator",
  "displayName": "Zippy Archon Orchestrator",
  "description": "Multi-agent development orchestrator with worktrees, trust validation, and marketplace integration",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zippy.initializeProject",
        "title": "Initialize Zippy Project",
        "category": "Zippy"
      },
      {
        "command": "zippy.createWorktree",
        "title": "Create Worktree from Task",
        "category": "Zippy"
      },
      {
        "command": "zippy.runLifecycle",
        "title": "Run Agent Lifecycle",
        "category": "Zippy"
      },
      {
        "command": "zippy.openContractsGraph",
        "title": "Open Contracts Graph",
        "category": "Zippy"
      },
      {
        "command": "zippy.qaCurrentWorktree",
        "title": "QA Current Worktree",
        "category": "Zippy"
      },
      {
        "command": "zippy.openPR",
        "title": "Open Pull Request",
        "category": "Zippy"
      },
      {
        "command": "zippy.switchAgentGenome",
        "title": "Switch Agent Genome",
        "category": "Zippy"
      },
      {
        "command": "zippy.viewAgentLogs",
        "title": "View Agent Logs",
        "category": "Zippy"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "zippyOrchestrator",
          "name": "Zippy Orchestrator",
          "icon": "$(robot)",
          "contextualTitle": "Zippy Archon Orchestrator"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zippyOrchestrator",
        "contents": "Initialize your project to get started with Zippy Archon.\n[Initialize Project](command:zippy.initializeProject)",
        "when": "!zippy.initialized"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zippy.initializeProject",
          "when": "view == zippyOrchestrator",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "zippy.createWorktree",
          "when": "view == zippyOrchestrator && viewItem == task",
          "group": "inline"
        },
        {
          "command": "zippy.runLifecycle",
          "when": "view == zippyOrchestrator && viewItem == task",
          "group": "inline"
        },
        {
          "command": "zippy.qaCurrentWorktree",
          "when": "view == zippyOrchestrator && viewItem == worktree",
          "group": "inline"
        },
        {
          "command": "zippy.viewAgentLogs",
          "when": "view == zippyOrchestrator && viewItem == agent",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Zippy Archon",
      "properties": {
        "zippy.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the Zippy Archon backend server"
        },
        "zippy.defaultGenome": {
          "type": "string",
          "default": "balanced",
          "enum": ["aggressive", "balanced", "conservative"],
          "description": "Default agent genome configuration"
        },
        "zippy.autoInitialize": {
          "type": "boolean",
          "default": false,
          "description": "Automatically initialize Zippy in detected projects"
        },
        "zippy.trustThreshold": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum trust score for marketplace items"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "ws": "^8.13.0"
  }
}
